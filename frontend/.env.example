# Copy to .env.local (local overrides) or set in the build environment.
# Only put PUBLIC values here: every VITE_ variable is bundled into the
# browser JavaScript. Never put database credentials in this file.

# REST API base URL. Leave unset for local use: when the page is served from
# localhost it defaults to http://localhost:8080/ords/smartbank/sb/api.
# A hosted build must point at the public HTTPS address of the read-only
# gateway (gateway/server.mjs), never at ORDS itself.
# VITE_API_BASE_URL=https://example.trycloudflare.com/api

# true = public read-only demo: transfer and alert-status actions are disabled.
# VITE_READ_ONLY=true
