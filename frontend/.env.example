# Copy to .env.local (local overrides) or set in the build environment.
# Only put PUBLIC values here: every VITE_ variable is bundled into the
# browser JavaScript. Never put database credentials or passwords here.

# REST API base URL. Leave unset for local use: when the page is served from
# localhost it defaults to http://localhost:8080/ords/smartbank/sb/api.
# The hosted build (GitHub Pages) uses the Oracle Autonomous Database ORDS URL,
# set as the repository variable SMARTBANK_API_URL (see docs/DEPLOYMENT.md):
# VITE_API_BASE_URL=https://<id>-smartbank.adb.<region>.oraclecloudapps.com/ords/sb/api

# Optional: true builds a read-only copy (transfer and alert actions disabled).
# VITE_READ_ONLY=true
